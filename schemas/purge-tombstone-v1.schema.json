{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TouristH/UNuse/main/schemas/purge-tombstone-v1.schema.json",
  "title": "UNuse purged lineage tombstone v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "lineageId", "generation", "repositoryId", "ownerId", "purgedBy", "purgedById", "purgedAt", "issueNumber", "commentId", "reason"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "maxLength": 128, "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9][a-z0-9-]*)+$" },
    "lineageId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "generation": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "repositoryId": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "ownerId": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "purgedBy": { "type": "string", "maxLength": 39, "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$" },
    "purgedById": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "purgedAt": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "issueNumber": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "commentId": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "reason": { "type": "string", "minLength": 1, "maxLength": 1024 }
  }
}
