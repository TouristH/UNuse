{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TouristH/UNuse/main/schemas/repository-v2.schema.json",
  "title": "UNuse plugin repository configuration v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "name", "sourceUrl", "launcherUrl", "indexPath",
    "indexV2Path", "v2MinimumLauncherVersion", "registryBotLogin", "trustedReviewers",
    "trustedReviewerIds"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 2 },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "sourceUrl": { "$ref": "#/$defs/githubRepository" },
    "launcherUrl": { "$ref": "#/$defs/httpsUrl" },
    "indexPath": { "const": "public/v1/index.json" },
    "indexV2Path": { "const": "public/v2/index.json" },
    "v2MinimumLauncherVersion": { "$ref": "#/$defs/semver" },
    "registryBotLogin": {
      "type": "string",
      "maxLength": 44,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?\\[bot\\]$"
    },
    "trustedReviewers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/githubLogin" }
    },
    "trustedReviewerIds": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": { "$ref": "#/$defs/githubLogin" },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9223372036854775807
      }
    }
  },
  "$defs": {
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^(?!.*[\\s\\\\\\u0000-\\u001F\\u007F])(?!.*%(?![0-9A-Fa-f]{2}))https://(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)(?:\\.(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?))*(?::443)?(?:[/?#]|$)"
    },
    "githubRepository": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/?$"
    },
    "githubLogin": {
      "type": "string",
      "maxLength": 39,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
    },
    "semver": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    }
  }
}
