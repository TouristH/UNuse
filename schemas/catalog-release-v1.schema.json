{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TouristH/UNuse/main/schemas/catalog-release-v1.schema.json",
  "title": "UNuse catalog release v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generation",
    "version",
    "channel",
    "publishedAt",
    "releaseNotesUrl",
    "download",
    "compatibility",
    "requiredCapabilities",
    "optionalCapabilities",
    "yanked"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "generation": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "version": { "$ref": "#/$defs/semver" },
    "channel": { "enum": ["stable", "preview"] },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "releaseNotesUrl": { "$ref": "#/$defs/httpsUrl" },
    "download": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "size"],
      "properties": {
        "url": { "$ref": "#/$defs/githubReleaseZip" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 1, "maximum": 268435456 }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestVersion", "apiVersion", "minimumLauncherVersion"],
      "properties": {
        "manifestVersion": { "type": "integer", "const": 1 },
        "apiVersion": { "type": "string", "pattern": "^1(?:\\.[0-9]+){1,2}$" },
        "minimumLauncherVersion": { "$ref": "#/$defs/semver" },
        "maximumLauncherVersionExclusive": { "$ref": "#/$defs/semver" }
      }
    },
    "requiredCapabilities": { "$ref": "#/$defs/capabilities" },
    "optionalCapabilities": { "$ref": "#/$defs/capabilities" },
    "yanked": { "type": "boolean" },
    "yankReason": { "type": "string", "minLength": 1, "maxLength": 1024 }
  },
  "$defs": {
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^(?!.*[\\s\\\\\\u0000-\\u001F\\u007F])(?!.*%(?![0-9A-Fa-f]{2}))https://(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)(?:\\.(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?))*(?::443)?(?:[/?#]|$)"
    },
    "githubReleaseZip": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^(?!.*[\\s\\\\\\u0000-\\u001F\\u007F])(?!.*%(?![0-9A-Fa-f]{2}))https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/releases/download/[^/?#]+/[^/?#]+\\.zip$"
    },
    "semver": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "capabilities": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ui.components",
          "ui.native",
          "network.http",
          "system.info.read",
          "user-files.read",
          "user-files.write",
          "process.start",
          "minecraft.instance.read",
          "minecraft.instance.modify",
          "minecraft.launch.modify"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "yanked": { "const": true } } },
      "then": { "required": ["yankReason"] },
      "else": { "not": { "required": ["yankReason"] } }
    }
  ]
}
