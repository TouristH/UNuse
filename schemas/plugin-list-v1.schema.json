{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TouristH/UNuse/main/schemas/plugin-list-v1.schema.json",
  "title": "UNuse active publisher repository list v1",
  "description": "The bounded list of monitored plugin publishers, bound to immutable GitHub numeric identities.",
  "type": "array",
  "maxItems": 2048,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "lineageId", "generation", "repositoryUrl", "repositoryId", "ownerId"],
    "properties": {
      "id": { "$ref": "#/$defs/pluginId" },
      "lineageId": { "$ref": "#/$defs/lineageId" },
      "generation": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
      "repositoryUrl": { "$ref": "#/$defs/githubRepository" },
      "repositoryId": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9223372036854775807
      },
      "ownerId": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9223372036854775807
      }
    }
  },
  "$defs": {
    "pluginId": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9][a-z0-9-]*)+$"
    },
    "lineageId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "githubRepository": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/?$"
    }
  }
}
