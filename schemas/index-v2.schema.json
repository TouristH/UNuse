{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TouristH/UNuse/main/schemas/index-v2.schema.json",
  "title": "UNuse identity-aware generated plugin index v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "sourceUrl", "minimumLauncherVersion", "plugins"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 2 },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "sourceUrl": { "$ref": "#/$defs/githubRepository" },
    "minimumLauncherVersion": { "$ref": "#/$defs/semver" },
    "plugins": {
      "type": "array",
      "maxItems": 2048,
      "items": { "$ref": "#/$defs/plugin" }
    }
  },
  "$defs": {
    "pluginId": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9][a-z0-9-]*)+$"
    },
    "lineageId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "semver": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^(?!.*[\\s\\\\\\u0000-\\u001F\\u007F])(?!.*%(?![0-9A-Fa-f]{2}))https://"
    },
    "githubReleaseZip": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^(?!.*[\\s\\\\\\u0000-\\u001F\\u007F])(?!.*%(?![0-9A-Fa-f]{2}))https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/releases/download/[^/?#]+/[^/?#]+\\.zip$"
    },
    "githubRepository": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/(?![A-Za-z0-9_.-]*\\.[gG][iI][tT]$)[A-Za-z0-9_.-]+$"
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryId", "ownerId"],
      "properties": {
        "repositoryId": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
        "ownerId": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "repositoryUrl", "repositoryUrlHistory", "publisher", "status"],
      "properties": {
        "generation": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "repositoryUrl": { "$ref": "#/$defs/githubRepository" },
        "repositoryUrlHistory": {
          "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
          "items": { "$ref": "#/$defs/githubRepository" }
        },
        "publisher": { "$ref": "#/$defs/publisher" },
        "status": { "enum": ["active", "retired", "transferred"] }
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "description", "authors", "repositoryUrl", "maintainers",
        "categories", "license", "lineageId", "generation", "lifecycleStatus",
        "visibility", "publisher", "generations", "releases"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/pluginId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "description": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "authors": {
          "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "repositoryUrl": { "$ref": "#/$defs/githubRepository" },
        "maintainers": {
          "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 39,
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
          }
        },
        "categories": {
          "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
          "items": { "enum": ["appearance", "automation", "gameplay", "integration", "launch", "management", "utilities"] }
        },
        "license": { "type": "string", "minLength": 1, "maxLength": 256 },
        "lineageId": { "$ref": "#/$defs/lineageId" },
        "generation": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "lifecycleStatus": { "enum": ["active", "retired", "transferred"] },
        "visibility": { "enum": ["listed", "hidden"] },
        "publisher": { "$ref": "#/$defs/publisher" },
        "generations": {
          "type": "array", "minItems": 1, "maxItems": 64,
          "items": { "$ref": "#/$defs/binding" }
        },
        "releases": {
          "type": "array", "minItems": 1, "maxItems": 128,
          "items": { "$ref": "#/$defs/release" }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation", "version", "channel", "publishedAt", "releaseNotesUrl",
        "download", "compatibility", "requiredCapabilities", "optionalCapabilities", "yanked"
      ],
      "properties": {
        "generation": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "version": { "$ref": "#/$defs/semver" },
        "channel": { "enum": ["stable", "preview"] },
        "publishedAt": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
        "releaseNotesUrl": { "$ref": "#/$defs/httpsUrl" },
        "download": {
          "type": "object", "additionalProperties": false,
          "required": ["url", "sha256", "size"],
          "properties": {
            "url": { "$ref": "#/$defs/githubReleaseZip" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "size": { "type": "integer", "minimum": 1, "maximum": 268435456 }
          }
        },
        "compatibility": {
          "type": "object", "additionalProperties": false,
          "required": ["manifestVersion", "apiVersion", "minimumLauncherVersion"],
          "properties": {
            "manifestVersion": { "type": "integer", "const": 1 },
            "apiVersion": { "type": "string", "pattern": "^1(?:\\.[0-9]+){1,2}$" },
            "minimumLauncherVersion": { "$ref": "#/$defs/semver" },
            "maximumLauncherVersionExclusive": { "$ref": "#/$defs/semver" }
          }
        },
        "requiredCapabilities": { "$ref": "#/$defs/capabilities" },
        "optionalCapabilities": { "$ref": "#/$defs/capabilities" },
        "yanked": { "type": "boolean" },
        "yankReason": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "review": { "$ref": "#/$defs/review" }
      },
      "allOf": [
        {
          "if": { "properties": { "yanked": { "const": true } } },
          "then": { "required": ["yankReason"] },
          "else": { "not": { "required": ["yankReason"] } }
        }
      ]
    },
    "capabilities": {
      "type": "array", "maxItems": 64, "uniqueItems": true,
      "items": {
        "enum": ["ui.components", "ui.native", "network.http", "system.info.read", "user-files.read", "user-files.write", "process.start", "minecraft.instance.read", "minecraft.instance.modify", "minecraft.launch.modify"]
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "sha256", "reviewedBy", "reviewedAt"],
      "properties": {
        "status": { "const": "verified" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "reviewedBy": {
          "type": "string",
          "maxLength": 39,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
        },
        "reviewedAt": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
        "notes": { "type": "string", "maxLength": 4096 }
      }
    }
  }
}
