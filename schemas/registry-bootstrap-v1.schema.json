{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TouristH/UNuse/main/schemas/registry-bootstrap-v1.schema.json",
  "title": "UNuse one-time registry v2 bootstrap trust anchor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "targetRepositorySchemaVersion",
    "trustedReviewerIds",
    "targetTrustedReviewerIds",
    "publisherBindings"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "targetRepositorySchemaVersion": { "type": "integer", "const": 2 },
    "trustedReviewerIds": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": { "$ref": "#/$defs/githubLogin" },
      "additionalProperties": { "$ref": "#/$defs/positiveInt64" }
    },
    "targetTrustedReviewerIds": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": { "$ref": "#/$defs/githubLogin" },
      "additionalProperties": { "$ref": "#/$defs/positiveInt64" }
    },
    "publisherBindings": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 2048,
      "propertyNames": { "$ref": "#/$defs/pluginId" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lineageId", "repositoryUrl", "repositoryId", "ownerId"],
        "properties": {
          "lineageId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "repositoryUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/(?![A-Za-z0-9_.-]*\\.[gG][iI][tT]$)[A-Za-z0-9_.-]+$"
          },
          "repositoryId": { "$ref": "#/$defs/positiveInt64" },
          "ownerId": { "$ref": "#/$defs/positiveInt64" }
        }
      }
    }
  },
  "$defs": {
    "pluginId": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9][a-z0-9-]*)+$"
    },
    "githubLogin": {
      "type": "string",
      "maxLength": 39,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
    },
    "positiveInt64": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    }
  }
}
