{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TouristH/UNuse/main/schemas/repository-v1.schema.json",
  "title": "UNuse plugin repository configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "sourceUrl", "launcherUrl", "indexPath", "registryBotLogin", "trustedReviewers"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "sourceUrl": { "$ref": "#/$defs/githubRepository" },
    "launcherUrl": { "$ref": "#/$defs/httpsUrl" },
    "indexPath": { "const": "public/v1/index.json" },
    "registryBotLogin": {
      "type": "string",
      "maxLength": 44,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?\\[bot\\]$"
    },
    "trustedReviewers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/githubLogin" }
    }
  },
  "$defs": {
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^(?!.*[\\s\\\\\\u0000-\\u001F\\u007F])(?!.*%(?![0-9A-Fa-f]{2}))https://(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)(?:\\.(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?))*(?::443)?(?:[/?#]|$)"
    },
    "githubRepository": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/?$"
    },
    "githubLogin": {
      "type": "string",
      "maxLength": 39,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
    }
  }
}
